        "tags": ["Reactions"],
        "summary": "Remove a reaction from a post",
        "description": "Removes the user's reaction from the post without toggling behavior.",
        "security": [{ "cookieAuth": [] }],
        "responses": {
          "200": {
            "description": "Reaction removed. Returns the updated post with new like/dislike counts.",
